// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventTypes            EventType[]
  availabilityRule      AvailabilityRule[]
  availabilityException AvailabilityException[]
  slots                 Slots[]
  bookings              Bookings[]              @relation("HostBookings")

  @@map("users")
}

model EventType {
  id                  Int      @id @default(autoincrement())
  hostId              Int
  title               String
  description         String?
  slug                String
  durationMinutes     Int
  isActive            Boolean  @default(true)
  locationType        String   @default("online")
  locationValue       String
  bufferBeforeMinutes Int      @default(0)
  bufferAfterMinutes  Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  host                User     @relation(fields: [hostId], references: [id], onDelete: Cascade)

  slots    Slots[]
  bookings Bookings[]

  @@unique([hostId, slug])
  @@map("event_types")
}

model AvailabilityRule {
  id        Int      @id @default(autoincrement())
  userId    Int
  weekday   Int
  startTime DateTime
  endTime   DateTime
  timezone  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekday])
  @@map("availability_rules")
}

model AvailabilityException {
  id          Int       @id @default(autoincrement())
  userId      Int
  date        DateTime  @db.Date
  type        String
  description String?
  startTime   DateTime?
  endTime     DateTime?
  TimeZone    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("availability_exception")
}

enum Status {
  AVAILABLE
  RESERVED
  CANCELLED
}

model Slots {
  id          Int      @id @default(autoincrement())
  hostId      Int
  eventTypeId Int
  startAt     DateTime @db.Time()
  endAt       DateTime @db.Time()
  duration    Int
  status      Status   @default(AVAILABLE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  host      User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)

  bookings Bookings[]

  @@unique([eventTypeId, startAt, endAt])
  @@index([hostId, startAt])
  @@index([eventTypeId, startAt, status])
  @@map("slots")
}

enum Booking_Status {
  SUCCESS
  FAIL
  PENDING
  REJECTED
}

model Bookings {
  id              Int            @id @default(autoincrement())
  userId          Int
  hostId          Int
  eventTypeId     Int
  slotId          Int
  inviteeEmail    String
  inviteeNotes    String?
  inviteePhone    String?
  meetLink        String
  calenderEventId String?
  cancelledAt     DateTime?
  status          Booking_Status
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now())

  host      User      @relation("HostBookings", fields: [userId], references: [id], onDelete: Cascade)
  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  slot      Slots     @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([inviteeEmail])
  @@index([hostId, createdAt])
  @@map("bookings")
}
